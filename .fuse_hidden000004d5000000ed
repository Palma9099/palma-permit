<script>
(function(){
  document.addEventListener("click",function(e){if(!e.target.closest)return;var t=e.target.closest('a[href^="tel:"]');if(t&&window.track)track("phone_click");var tl=e.target.closest('[data-tool]');if(tl&&window.track)track("tool_click",{tool:tl.getAttribute("data-tool")});});
  var lf=document.getElementById("leadform"); if(!lf)return;
  lf.addEventListener("submit",function(e){
    e.preventDefault();
    var v=function(id){return (document.getElementById(id).value||"").trim();};
    var name=v("lf-name"),phone=v("lf-phone"),email=v("lf-email"),ad=v("lf-addr"),type=v("lf-type"),msg=v("lf-msg");
    var st=document.getElementById("lf-status"),sb=document.getElementById("lf-submit");
    st.className="status";st.textContent="";
    if(!name||!phone||!/.+@.+\..+/.test(email)){st.className="status err";st.textContent="Please enter your name, phone, and a valid email.";return;}
    var body={name:name,email:email,message:"[Website estimate request]\nPage: Services hub\nProject: "+(type||"Not specified")+"\nPhone: "+phone+"\nAddress: "+(ad||"Not provided")+"\n\n"+(msg||"(no message)")};
    sb.disabled=true;sb.textContent="Sending…";
    fetch("/api/support",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)})
      .then(function(r){return r.json().then(function(j){return {ok:r.ok,j:j};});})
      .then(function(res){if(res.ok){if(window.track)track("generate_lead",{page:"services"});lf.reset();st.className="status ok";st.textContent="Thanks! We received your request and will reach out shortly.";}else{st.className="status err";st.textContent=(res.j&&res.j.message)||"Something went wrong. Please call 305-393-0690.";}})
      .catch(function(){st.className="status err";st.textContent="Network error. Please call 305-393-0690.";})
      .finally(function(){sb.disabled=false;sb.textContent="Request my free estimate";});
  });
})();
</script>
