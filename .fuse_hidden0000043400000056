<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>New search — Palma Permit</title>
<meta name="description" content="Start a new property / permit search.">
<meta name="theme-color" content="#0a0f1c">
<meta property="og:title" content="New search — Palma Permit">
<meta property="og:description" content="Start a new property / permit search.">
<meta property="og:type" content="website">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">
</head>
<body data-page="" data-pp-page="search" data-pp-guard="member">
<div id="app-header"></div>

<main>
  <section class="section tight"><div class="wrap">
      <span class="eyebrow">New search</span>
      <h1 style="font-size:clamp(1.9rem,3.5vw,2.7rem)">Start a permit / property search</h1>
      <p class="lead">Tell us about the property and project. We'll create a report request you can track from your dashboard.</p>
      <form id="search-form" class="card pad-lg" style="margin-top:22px;max-width:640px">
        <label>Property address<br><input id="f-address" required maxlength="300" placeholder="123 NW 1st Ave" style="width:100%"></label><br><br>
        <div class="grid grid-2">
          <label>City<br><input id="f-city" required maxlength="100" placeholder="Miami" style="width:100%"></label>
          <label>State<br><input id="f-state" value="FL" maxlength="30" style="width:100%"></label>
        </div><br>
        <div class="grid grid-2">
          <label>Property type<br><select id="f-property" style="width:100%"><option>Commercial</option><option>Residential</option><option>Mixed-use</option><option>Industrial</option></select></label>
          <label>Project type<br><select id="f-project" style="width:100%"><option>New construction</option><option>Renovation / remodel</option><option>Addition</option><option>Change of use</option><option>Repair / replacement</option><option>Other</option></select></label>
        </div><br>
        <label>Permit question (optional)<br><textarea id="f-question" rows="4" maxlength="2000" placeholder="Anything specific you want checked?" style="width:100%"></textarea></label><br><br>
        <button class="btn btn-primary btn-lg" id="search-submit" type="submit">Submit search</button>
        <p id="search-msg" style="margin-top:10px"></p>
      </form>
  </div></section>
</main>

<div id="app-footer"></div>
<script src="/assets/data.js"></script>
<script src="/assets/app.js"></script>
<script src="/assets/auth.js"></script>
<script src="/assets/member.js"></script>
</body>
</html>
